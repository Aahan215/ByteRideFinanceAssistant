# --- Everyone copies this to .env ---
#
# This file carries the ENDPOINT and CREDENTIALS ONLY. Which model, what
# temperature, what context size -- all of that lives in config/models.yaml,
# in git, so it is identical for all five of us.

# === Current: Gemini API (Google AI Studio) ===
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_BASE_URL is inferred from `provider:` in config/models.yaml; override only
# if you need a different endpoint.

# === Later: local open models ===
# Set `provider: ollama` in config/models.yaml, then:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://192.168.1.XXX:11434/v1
# LLM_API_KEY=ollama

LLM_TIMEOUT=90

# === Dataset source: live MySQL (organisers' DB) ===
# Set all five to load from MySQL instead of data/raw/*.csv; run `make load`
# afterwards to materialise + enrich it into data/finance.duckdb as usual.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- AES-256 for encrypted columns (organisers' key; NEVER commit) ---
FINANCE_AES_KEY=
FINANCE_AES_IV=
FINANCE_AES_MODE=ctr        # ctr | cbc | gcm -- confirm with scripts/crypto_probe.py

# --- Dev only: keyword planner instead of a model. Unset before demoing. ---
# FINANCE_STUB_PLANNER=1
