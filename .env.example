# --- Everyone copies this to .env ---

# Model host's Mac (running Ollama, shared on the LAN):
LLM_BASE_URL=http://192.168.1.XXX:11434/v1
LLM_API_KEY=ollama

# Fallback when the host Mac is asleep or you're off the venue wifi --
# swap to the hackathon API credits. Use an OPEN-WEIGHTS model so the
# <=20B parameter claim stays verifiable by the judges.
# LLM_BASE_URL=https://<provider>/v1
# LLM_API_KEY=sk-...

LLM_ROUTER=qwen3:0.6b
LLM_PLANNER=qwen3:8b
LLM_NARRATOR=qwen3:8b
LLM_ESCALATE=gpt-oss:20b
