# --- Everyone copies this to .env ---
#
# This file carries the ENDPOINT ONLY. Which model, what temperature, what
# context size -- all of that lives in config/models.yaml, in git, so it is
# identical for all five of us.
#
# Do NOT run your own Ollama. One shared server is the point: it makes eval
# numbers comparable across the team and matches what the demo machine does.

LLM_BASE_URL=http://192.168.1.XXX:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT=90

# If the venue wifi isolates clients, the host runs a tunnel and shares
# the https URL instead:
# LLM_BASE_URL=https://<something>.trycloudflare.com/v1
